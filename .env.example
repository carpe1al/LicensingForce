# Public URL of the site (used for sitemap and social previews)
NEXT_PUBLIC_SITE_URL=https://licensingforce.com

# Contact form email delivery via Resend (https://resend.com)
RESEND_API_KEY=
# Where contact form submissions are sent
CONTACT_TO_EMAIL=info@licensingforce.com
# Sender address; must be on a domain verified in Resend
CONTACT_FROM_EMAIL=Licensing Force Website <website@licensingforce.com>
